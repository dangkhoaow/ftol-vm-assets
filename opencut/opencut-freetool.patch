diff --git a/apps/web/src/copilot/components/copilot-popover.tsx b/apps/web/src/copilot/components/copilot-popover.tsx
new file mode 100644
index 0000000..08aec95
--- /dev/null
+++ b/apps/web/src/copilot/components/copilot-popover.tsx
@@ -0,0 +1,160 @@
+"use client";
+
+// FreeToolOnline addition: the AI copilot panel.
+//
+// Type an instruction ("cut the first 3 seconds and add the title Hello at
+// 0:02"); a language model running ON THIS DEVICE (WebGPU) turns it into a
+// validated list of edit operations, which are applied through the editor's
+// normal command stack - so everything the copilot does is a regular,
+// undoable edit. It can also suggest titles/captions from what is on the
+// timeline. Machines without a usable WebGPU adapter see the button disabled
+// with an explanation instead of an error.
+
+import { useEffect, useState } from "react";
+import {
+	Popover,
+	PopoverContent,
+	PopoverTrigger,
+} from "@/components/ui/popover";
+import { Button } from "@/components/ui/button";
+import { Textarea } from "@/components/ui/textarea";
+import { useEditor } from "@/editor/use-editor";
+import {
+	applyCopilotPlan,
+	copilotContract,
+	copilotPlanSchema,
+	describeTimeline,
+} from "../ops";
+import { planFromInstruction, probeWebGpu, suggestText } from "../llm";
+
+export function CopilotPopover() {
+	const editor = useEditor();
+	const [gpuOk, setGpuOk] = useState<boolean | null>(null);
+	const [instruction, setInstruction] = useState("");
+	const [busy, setBusy] = useState(false);
+	const [status, setStatus] = useState("");
+	const [log, setLog] = useState<string[]>([]);
+
+	useEffect(() => {
+		let mounted = true;
+		probeWebGpu().then((ok) => {
+			if (mounted) setGpuOk(ok);
+		});
+		// Test hook: lets the e2e harness exercise the SAME validated op
+		// pipeline the model uses, without needing a GPU in CI. Only exists
+		// when the page is opened with ?copilotDebug=1.
+		if (typeof window !== "undefined" && window.location.search.includes("copilotDebug=1")) {
+			(window as unknown as Record<string, unknown>).__ftolCopilotApply = (planJson: string) => {
+				const plan = copilotPlanSchema.parse(JSON.parse(planJson));
+				return applyCopilotPlan({ editor, plan });
+			};
+			(window as unknown as Record<string, unknown>).__ftolCopilotDescribe = () =>
+				describeTimeline({ editor });
+		}
+		return () => {
+			mounted = false;
+		};
+	}, [editor]);
+
+	const run = async () => {
+		const text = instruction.trim();
+		if (!text || busy) return;
+		setBusy(true);
+		setLog([]);
+		try {
+			const plan = await planFromInstruction({
+				instruction: text,
+				timeline: describeTimeline({ editor }),
+				contract: copilotContract(),
+				onStatus: setStatus,
+			});
+			const applied = applyCopilotPlan({ editor, plan });
+			setLog(applied);
+			setStatus(
+				plan.note
+					? `Done - ${plan.note} (everything is undoable with Ctrl+Z).`
+					: "Done - every change is a normal edit you can undo with Ctrl+Z.",
+			);
+		} catch (e) {
+			setStatus(`Copilot: ${(e as Error).message}`);
+		} finally {
+			setBusy(false);
+		}
+	};
+
+	const suggest = async () => {
+		if (busy) return;
+		setBusy(true);
+		setLog([]);
+		try {
+			const text = await suggestText({
+				prompt:
+					"Here is what sits on a video timeline:\n" +
+					describeTimeline({ editor }) +
+					"\n\nSuggest 3 short video titles and one 1-sentence description. Plain text only.",
+				onStatus: setStatus,
+			});
+			setLog(text.split("\n").filter(Boolean).slice(0, 8));
+			setStatus("Suggestions written on this device - nothing was uploaded.");
+		} catch (e) {
+			setStatus(`Copilot: ${(e as Error).message}`);
+		} finally {
+			setBusy(false);
+		}
+	};
+
+	return (
+		<Popover>
+			<PopoverTrigger asChild>
+				<Button variant="outline" className="h-8">
+					AI copilot
+				</Button>
+			</PopoverTrigger>
+			<PopoverContent className="w-96" align="end">
+				<div className="flex flex-col gap-2">
+					<p className="text-sm font-medium">AI copilot (runs on this device)</p>
+					{gpuOk === false ? (
+						<p className="text-muted-foreground text-xs">
+							This browser has no usable WebGPU adapter, so the local language
+							model cannot run here. Every editing feature still works - the
+							copilot is only a convenience layer over them.
+						</p>
+					) : (
+						<>
+							<Textarea
+								placeholder={
+									'e.g. "cut the first 3 seconds, add the title Hello at 2s, and mute everything"'
+								}
+								value={instruction}
+								onChange={(e) => setInstruction(e.target.value)}
+								rows={3}
+								disabled={busy}
+							/>
+							<div className="flex gap-2">
+								<Button size="sm" onClick={run} disabled={busy || !instruction.trim()}>
+									{busy ? "Working..." : "Apply with the local model"}
+								</Button>
+								<Button size="sm" variant="outline" onClick={suggest} disabled={busy}>
+									Suggest titles
+								</Button>
+							</div>
+							<p className="text-muted-foreground text-xs">
+								First use downloads a ~700 MB model that the browser keeps.
+								Your video, timeline and words never leave this tab, and every
+								change the copilot makes is a normal undoable edit.
+							</p>
+						</>
+					)}
+					{status ? <p className="text-xs">{status}</p> : null}
+					{log.length > 0 ? (
+						<ul className="text-muted-foreground max-h-40 list-disc overflow-auto pl-4 text-xs">
+							{log.map((line, i) => (
+								<li key={i}>{line}</li>
+							))}
+						</ul>
+					) : null}
+				</div>
+			</PopoverContent>
+		</Popover>
+	);
+}
diff --git a/apps/web/src/copilot/llm.ts b/apps/web/src/copilot/llm.ts
new file mode 100644
index 0000000..72c12bf
--- /dev/null
+++ b/apps/web/src/copilot/llm.ts
@@ -0,0 +1,164 @@
+// FreeToolOnline addition: the on-device language model behind the copilot.
+//
+// web-llm (Apache-2.0) runs the model on WebGPU inside this tab; nothing the
+// user types leaves the browser. Availability is decided by an AWAITED
+// requestAdapter() probe - never by feature-detecting navigator.gpu, which
+// exists on machines that cannot actually provide an adapter.
+
+import { copilotPlanSchema, type CopilotPlan } from "./ops";
+
+const MODEL_ID = "Llama-3.2-1B-Instruct-q4f16_1-MLC";
+
+type Engine = {
+	chat: {
+		completions: {
+			create: (args: {
+				messages: { role: string; content: string }[];
+				temperature: number;
+				max_tokens: number;
+			}) => Promise<{
+				choices?: { message?: { content?: string } }[];
+			}>;
+		};
+	};
+};
+
+let gpuOk: boolean | null = null;
+let enginePromise: Promise<Engine> | null = null;
+
+export async function probeWebGpu(): Promise<boolean> {
+	if (gpuOk !== null) return gpuOk;
+	try {
+		const gpu = (navigator as { gpu?: { requestAdapter?: () => Promise<unknown> } }).gpu;
+		if (!gpu || !gpu.requestAdapter) {
+			gpuOk = false;
+			return gpuOk;
+		}
+		const adapter = await gpu.requestAdapter();
+		gpuOk = Boolean(adapter);
+	} catch {
+		gpuOk = false;
+	}
+	return gpuOk;
+}
+
+export function loadEngine({
+	onStatus,
+}: {
+	onStatus: (text: string) => void;
+}): Promise<Engine> {
+	if (!enginePromise) {
+		onStatus(
+			"Loading the local language model (a one-time download of roughly 700 MB that the browser keeps)...",
+		);
+		enginePromise = import("@mlc-ai/web-llm").then(async (webllm) => {
+			const engine = new webllm.MLCEngine();
+			engine.setInitProgressCallback((p: { text?: string }) => {
+				onStatus(`Language model: ${p?.text ?? "loading"}...`);
+			});
+			const list = webllm.prebuiltAppConfig?.model_list ?? [];
+			let id: string | null = null;
+			if (list.some((m: { model_id: string }) => m.model_id === MODEL_ID)) {
+				id = MODEL_ID;
+			} else {
+				const small = list.find((m: { model_id: string }) =>
+					/1B|1_5B|1\.5B/i.test(m.model_id),
+				);
+				id = small?.model_id ?? list[0]?.model_id ?? null;
+			}
+			if (!id) throw new Error("no model available in the web-llm registry");
+			await engine.reload(id);
+			return engine as unknown as Engine;
+		});
+		enginePromise.catch(() => {
+			enginePromise = null;
+		});
+	}
+	return enginePromise;
+}
+
+function extractJson({ text }: { text: string }): string {
+	const start = text.indexOf("{");
+	const end = text.lastIndexOf("}");
+	if (start === -1 || end === -1 || end <= start) return text;
+	return text.slice(start, end + 1);
+}
+
+// Ask the model for a plan; feed schema errors back for up to three attempts.
+export async function planFromInstruction({
+	instruction,
+	timeline,
+	contract,
+	onStatus,
+}: {
+	instruction: string;
+	timeline: string;
+	contract: string;
+	onStatus: (text: string) => void;
+}): Promise<CopilotPlan> {
+	const engine = await loadEngine({ onStatus });
+	const messages: { role: string; content: string }[] = [
+		{
+			role: "system",
+			content: `You turn video-editing instructions into edit operations.\n${contract}`,
+		},
+		{
+			role: "user",
+			content: `Current timeline:\n${timeline}\n\nInstruction: ${instruction}`,
+		},
+	];
+	let lastError = "";
+	for (let attempt = 1; attempt <= 3; attempt++) {
+		onStatus(`Writing the edit plan (attempt ${attempt} of 3)...`);
+		const res = await engine.chat.completions.create({
+			messages,
+			temperature: 0.2,
+			max_tokens: 900,
+		});
+		const text = res?.choices?.[0]?.message?.content ?? "";
+		let candidate: unknown;
+		try {
+			candidate = JSON.parse(extractJson({ text }));
+		} catch (e) {
+			lastError = `not parseable JSON (${(e as Error).message})`;
+			messages.push({ role: "assistant", content: text.slice(0, 1500) });
+			messages.push({
+				role: "user",
+				content: `That was ${lastError}. Send ONLY the JSON object.`,
+			});
+			continue;
+		}
+		const parsed = copilotPlanSchema.safeParse(candidate);
+		if (parsed.success) return parsed.data;
+		lastError = parsed.error.issues
+			.slice(0, 5)
+			.map((i) => `${i.path.join(".")}: ${i.message}`)
+			.join("; ");
+		messages.push({ role: "assistant", content: text.slice(0, 1500) });
+		messages.push({
+			role: "user",
+			content: `That JSON failed the contract: ${lastError}. Fix exactly these problems and resend the full object.`,
+		});
+	}
+	throw new Error(
+		`the model could not produce a valid plan in 3 attempts (${lastError}) - use the timeline directly instead`,
+	);
+}
+
+// Free-text generation (titles, caption wording) from timeline context.
+export async function suggestText({
+	prompt,
+	onStatus,
+}: {
+	prompt: string;
+	onStatus: (text: string) => void;
+}): Promise<string> {
+	const engine = await loadEngine({ onStatus });
+	onStatus("Writing suggestions...");
+	const res = await engine.chat.completions.create({
+		messages: [{ role: "user", content: prompt }],
+		temperature: 0.7,
+		max_tokens: 400,
+	});
+	return res?.choices?.[0]?.message?.content ?? "";
+}
diff --git a/apps/web/src/copilot/ops.ts b/apps/web/src/copilot/ops.ts
new file mode 100644
index 0000000..14e32e4
--- /dev/null
+++ b/apps/web/src/copilot/ops.ts
@@ -0,0 +1,243 @@
+// FreeToolOnline addition: the AI copilot's edit-operation contract.
+//
+// The language model NEVER touches the editor directly. It emits a JSON list
+// of operations that (a) must parse against the zod schema below and (b) are
+// applied by deterministic code through the same TimelineManager commands the
+// UI uses - so every applied op is undoable with the normal history stack.
+
+import { z } from "zod";
+import type { EditorCore } from "@/core";
+import { mediaTimeFromSeconds, mediaTimeToSeconds } from "@/wasm";
+import type { MediaTime } from "@/wasm";
+import { buildTextElement } from "@/timeline/element-utils";
+import { DEFAULTS } from "@/timeline/defaults";
+import type { TimelineTrack, TimelineElement } from "@/timeline/types";
+
+const seconds = z.number().min(0).max(60 * 60 * 6);
+
+export const copilotOpSchema = z.discriminatedUnion("op", [
+	z.object({ op: z.literal("seek"), seconds }),
+	z.object({ op: z.literal("play") }),
+	z.object({ op: z.literal("pause") }),
+	z.object({ op: z.literal("split"), seconds }),
+	z.object({
+		op: z.literal("delete_range"),
+		start_seconds: seconds,
+		end_seconds: seconds,
+	}),
+	z.object({ op: z.literal("delete_element"), element: z.number().int().min(0) }),
+	z.object({
+		op: z.literal("add_text"),
+		text: z.string().min(1).max(500),
+		start_seconds: seconds,
+		duration_seconds: z.number().min(0.2).max(600).default(4),
+	}),
+	z.object({
+		op: z.literal("mute"),
+		element: z.number().int().min(0).optional(),
+	}),
+	z.object({
+		op: z.literal("unmute"),
+		element: z.number().int().min(0).optional(),
+	}),
+	z.object({ op: z.literal("undo") }),
+]);
+
+export const copilotPlanSchema = z.object({
+	ops: z.array(copilotOpSchema).min(1).max(20),
+	note: z.string().max(300).optional(),
+});
+
+export type CopilotOp = z.infer<typeof copilotOpSchema>;
+export type CopilotPlan = z.infer<typeof copilotPlanSchema>;
+
+interface IndexedElement {
+	index: number;
+	trackId: string;
+	element: TimelineElement;
+}
+
+function listElements({ editor }: { editor: EditorCore }): IndexedElement[] {
+	const scene = editor.scenes.getActiveSceneOrNull();
+	if (!scene) return [];
+	const tracks: TimelineTrack[] = [
+		...scene.tracks.overlay,
+		scene.tracks.main,
+		...scene.tracks.audio,
+	];
+	const out: IndexedElement[] = [];
+	let index = 0;
+	for (const track of tracks) {
+		for (const element of track.elements) {
+			out.push({ index, trackId: track.id, element });
+			index += 1;
+		}
+	}
+	return out;
+}
+
+// Compact, model-facing description of the current timeline. Element indices
+// here are the ONLY handles the model may reference in delete_element / mute.
+export function describeTimeline({ editor }: { editor: EditorCore }): string {
+	const items = listElements({ editor });
+	if (items.length === 0) return "The timeline is empty.";
+	const total = mediaTimeToSeconds({ time: editor.timeline.getTotalDuration() });
+	const lines = items.map(({ index, element }) => {
+		const start = mediaTimeToSeconds({ time: element.startTime });
+		const end = start + mediaTimeToSeconds({ time: element.duration });
+		const kind = element.type;
+		const name = ("name" in element && element.name) || kind;
+		return `#${index} [${kind}] "${String(name).slice(0, 40)}" ${start.toFixed(2)}s -> ${end.toFixed(2)}s${"muted" in element && element.muted ? " (muted)" : ""}`;
+	});
+	return `Total duration ${total.toFixed(2)}s. Elements:\n${lines.join("\n")}`;
+}
+
+function elementsCrossing({
+	editor,
+	time,
+}: {
+	editor: EditorCore;
+	time: MediaTime;
+}): { trackId: string; elementId: string }[] {
+	const t = mediaTimeToSeconds({ time: time });
+	return listElements({ editor })
+		.filter(({ element }) => {
+			const start = mediaTimeToSeconds({ time: element.startTime });
+			const end = start + mediaTimeToSeconds({ time: element.duration });
+			return start + 0.01 < t && t < end - 0.01;
+		})
+		.map(({ trackId, element }) => ({ trackId, elementId: element.id }));
+}
+
+export function applyCopilotPlan({
+	editor,
+	plan,
+}: {
+	editor: EditorCore;
+	plan: CopilotPlan;
+}): string[] {
+	const log: string[] = [];
+	for (const op of plan.ops) {
+		switch (op.op) {
+			case "seek": {
+				editor.playback.seek({ time: mediaTimeFromSeconds({ seconds: op.seconds }) });
+				log.push(`Moved the playhead to ${op.seconds}s.`);
+				break;
+			}
+			case "play":
+				editor.playback.play();
+				log.push("Playing.");
+				break;
+			case "pause":
+				editor.playback.pause();
+				log.push("Paused.");
+				break;
+			case "split": {
+				const time = mediaTimeFromSeconds({ seconds: op.seconds });
+				const targets = elementsCrossing({ editor, time });
+				if (targets.length === 0) {
+					log.push(`Nothing crosses ${op.seconds}s, so there was nothing to split.`);
+					break;
+				}
+				editor.timeline.splitElements({ elements: targets, splitTime: time });
+				log.push(`Split ${targets.length} element(s) at ${op.seconds}s.`);
+				break;
+			}
+			case "delete_range": {
+				const start = Math.min(op.start_seconds, op.end_seconds);
+				const end = Math.max(op.start_seconds, op.end_seconds);
+				if (end - start < 0.05) {
+					log.push("The range is too small to delete.");
+					break;
+				}
+				const startT = mediaTimeFromSeconds({ seconds: start });
+				const endT = mediaTimeFromSeconds({ seconds: end });
+				const atStart = elementsCrossing({ editor, time: startT });
+				if (atStart.length) editor.timeline.splitElements({ elements: atStart, splitTime: startT });
+				const atEnd = elementsCrossing({ editor, time: endT });
+				if (atEnd.length) editor.timeline.splitElements({ elements: atEnd, splitTime: endT });
+				const doomed = listElements({ editor })
+					.filter(({ element }) => {
+						const s = mediaTimeToSeconds({ time: element.startTime });
+						const e = s + mediaTimeToSeconds({ time: element.duration });
+						return s >= start - 0.01 && e <= end + 0.01;
+					})
+					.map(({ trackId, element }) => ({ trackId, elementId: element.id }));
+				if (doomed.length === 0) {
+					log.push(`No element sits fully inside ${start}s-${end}s.`);
+					break;
+				}
+				editor.timeline.deleteElements({ elements: doomed });
+				log.push(`Deleted ${doomed.length} element(s) between ${start}s and ${end}s.`);
+				break;
+			}
+			case "delete_element": {
+				const item = listElements({ editor }).find((i) => i.index === op.element);
+				if (!item) {
+					log.push(`There is no element #${op.element}.`);
+					break;
+				}
+				editor.timeline.deleteElements({
+					elements: [{ trackId: item.trackId, elementId: item.element.id }],
+				});
+				log.push(`Deleted element #${op.element}.`);
+				break;
+			}
+			case "add_text": {
+				const element = buildTextElement({
+					raw: {
+						...DEFAULTS.text.element,
+						duration: mediaTimeFromSeconds({ seconds: op.duration_seconds }),
+						params: { content: op.text },
+					},
+					startTime: mediaTimeFromSeconds({ seconds: op.start_seconds }),
+				});
+				editor.timeline.insertElement({ element, placement: { mode: "auto" } });
+				log.push(`Added the text "${op.text.slice(0, 40)}" at ${op.start_seconds}s for ${op.duration_seconds}s.`);
+				break;
+			}
+			case "mute":
+			case "unmute": {
+				const wantMuted = op.op === "mute";
+				const items = listElements({ editor }).filter((i) =>
+					op.element === undefined ? true : i.index === op.element,
+				);
+				const toToggle = items.filter(
+					({ element }) => "muted" in element && element.muted !== wantMuted,
+				);
+				if (toToggle.length === 0) {
+					log.push(`Nothing needed ${op.op}.`);
+					break;
+				}
+				editor.timeline.toggleElementsMuted({
+					elements: toToggle.map(({ trackId, element }) => ({
+						trackId,
+						elementId: element.id,
+					})),
+				});
+				log.push(`${wantMuted ? "Muted" : "Unmuted"} ${toToggle.length} element(s).`);
+				break;
+			}
+			case "undo":
+				editor.command.undo();
+				log.push("Undid the last edit.");
+				break;
+		}
+	}
+	return log;
+}
+
+export function copilotContract(): string {
+	return [
+		'Reply with ONLY a JSON object, no prose, no markdown fences: {"ops":[...],"note":"optional short summary"}.',
+		"Allowed ops (times are seconds as plain numbers):",
+		'{"op":"seek","seconds":n} {"op":"play"} {"op":"pause"}',
+		'{"op":"split","seconds":n} - splits every element crossing that time',
+		'{"op":"delete_range","start_seconds":n,"end_seconds":n} - removes that stretch of the timeline content',
+		'{"op":"delete_element","element":i} - i is the #index from the timeline listing',
+		'{"op":"add_text","text":"...","start_seconds":n,"duration_seconds":n}',
+		'{"op":"mute","element":i?} {"op":"unmute","element":i?} - omit element to affect everything',
+		'{"op":"undo"}',
+		"Use at most 20 ops. Only reference #indices that exist in the listing.",
+	].join("\n");
+}
